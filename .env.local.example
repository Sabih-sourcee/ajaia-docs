# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used server-side only (API routes) so RLS-free tables stay safe from the
# browser. If you don't have it, the anon key also works for this project
# since there is no RLS (access is checked in app code, see ARCHITECTURE.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
