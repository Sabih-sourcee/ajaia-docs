# Vercel Postgres (Neon-backed) connection string(s).
#
# Easiest path: in the Vercel dashboard, open this project -> Storage ->
# Create Database -> Postgres (free tier), then "Connect Project". That
# writes these variables for you. For local development, pull them down:
#
#   vercel link
#   vercel env pull .env.local
#
# @vercel/postgres reads POSTGRES_URL automatically; the others are provided
# for completeness / direct psql access.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
POSTGRES_PRISMA_URL=postgres://user:password@host/dbname?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host/dbname?sslmode=require
